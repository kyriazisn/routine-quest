# Copy to .env for local development. Never commit .env.
RQ_ENV=dev
RQ_DATABASE_URL=postgresql+psycopg://rq:rq-dev-only@db:5432/routinequest
RQ_PUBLIC_APP_URL=http://localhost:5173
RQ_COOKIE_SECURE=false

# Magic-link delivery: "console" prints links in the API log (dev only; refused when RQ_ENV=prod)
RQ_MAILER=console
# RQ_MAILER=smtp
# RQ_SMTP_HOST=<smtp-host>
# RQ_SMTP_PORT=587
# RQ_SMTP_USER=<smtp-user>
# RQ_SMTP_PASSWORD=<smtp-password>
# RQ_SMTP_FROM=Routine Quest <no-reply@<your-domain>>

# Web Push — generate with: docker compose run --rm api python -m app.cli vapid-keys
RQ_VAPID_PRIVATE_KEY=
RQ_VAPID_PUBLIC_KEY=
RQ_VAPID_SUBJECT=mailto:<admin-email>

# Firmware OTA offered to devices (optional)
RQ_FW_LATEST_VERSION=
RQ_FW_LATEST_URL=
